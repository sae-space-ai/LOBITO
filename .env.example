# ============================================================
# VARIABLES DE ENTORNO - Agente IA Núcleo Operativo v2
# ============================================================
# Copia este archivo a .env y configura los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# --- Motor de Inteligencia Artificial (Qwen) ---
# Obtén tu API key en: https://dashscope.console.aliyun.com/
VITE_QWEN_API_KEY=
VITE_QWEN_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
VITE_QWEN_MODEL=qwen-turbo

# --- Base de Datos PostgreSQL ---
# Configura para persistencia centralizada (requiere servidor)
VITE_DATABASE_HOST=
VITE_DATABASE_PORT=5432
VITE_DATABASE_NAME=agent_ia
VITE_DATABASE_USER=
VITE_DATABASE_PASSWORD=
VITE_DATABASE_SSL=false

# --- Backend API (para despliegue en Vercel) ---
VITE_API_BASE_URL=

# --- Seguridad ---
VITE_JWT_SECRET=
VITE_CORS_ORIGINS=http://localhost:5173
