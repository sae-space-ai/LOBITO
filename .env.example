# ============================================================
# VARIABLES DE ENTORNO - Agente IA Núcleo Operativo v3
# ============================================================
# COPIA este archivo a .env y configura los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# ============================================================
# ⚠️ SEGURIDAD CRÍTICA ⚠️
# Las siguientes variables son PRIVADAS DEL SERVIDOR.
# NUNCA uses el prefijo VITE_ para credenciales.
# El prefijo VITE_ expone variables al navegador.
# ============================================================

# --- Motor de Inteligencia Artificial (Qwen) ---
# Obtén tu API key en: https://dashscope.console.aliyun.com/
# SOLO en el servidor. NUNCA en el frontend.
QWEN_API_KEY=
QWEN_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL=qwen-turbo
QWEN_MAX_TOKENS=2000
QWEN_TEMPERATURE=0.3
QWEN_TIMEOUT=30000

# --- Base de Datos PostgreSQL ---
# Formato: postgresql://user:password@host:port/database
# SOLO en el servidor. NUNCA en el frontend.
DATABASE_URL=
DB_MAX_CONNECTIONS=10
DB_SSL=true

# --- Seguridad y Autenticación ---
JWT_SECRET=
API_KEY=

# --- CORS (orígenes permitidos) ---
CORS_ORIGINS=http://localhost:5173,https://tudominio.vercel.app

# ============================================================
# VARIABLES DEL FRONTEND (públicas, sin secretos)
# ============================================================
# Estas son las ÚNICAS que pueden tener prefijo VITE_
# y NUNCA deben contener credenciales.
VITE_APP_NAME=Agente IA
VITE_APP_VERSION=3.0.0
VITE_API_BASE_URL=
